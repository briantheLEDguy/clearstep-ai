# Local Supabase Edge Function template. Copy to an ignored local file only.
# Use test credentials and placeholders here; set deployed values through
# Supabase secret management. Do not add SUPABASE_SERVICE_ROLE_KEY to this file.
# At production cutover, PUBLIC_SITE_URL must be https://www.bncconsulting.nl.

PUBLIC_SITE_URL=http://127.0.0.1:3000
ADMIN_NOTIFICATION_EMAIL=operations@example.test

# Stripe: use a least-privilege *test* key locally and separate live values.
STRIPE_API_KEY=rk_test_replace_me
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_replace_me
STRIPE_AUTOMATIC_TAX_ENABLED=false

# Dedicated Google Workspace OAuth client and calendar used only for local tests.
GOOGLE_CLIENT_ID=replace_me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:54321/functions/v1/google-oauth-callback
GOOGLE_WORKSPACE_EMAIL=operations@example.test
GOOGLE_WORKSPACE_DOMAIN=example.test
GOOGLE_CALENDAR_ID=replace_with_test_calendar_id

# Generate unique local values; never reuse production secrets.
RATE_LIMIT_HASH_SALT=replace_with_a_long_random_value
SEND_EMAIL_HOOK_SECRET=v1,whsec_replace_me
